@model System.Collections.Generic.List<Ghaforv3.Models.Banner>
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewBag.Title = "بنرها"; }
@foreach (var b in Model)
{
    <div class="a-item">
        <div class="thumb">@if (!string.IsNullOrEmpty(b.ImageUrl)) { <img src="@Url.Content(b.ImageUrl)" alt="" /> } else { <span>🖼</span> }</div>
        <div class="grow">
            <b>@(b.Title)</b>
            <small class="muted">@(b.Highlight) · ترتیب @(b.SortOrder)</small>
            @if (!b.IsActive) { <span class="a-badge off">غیرفعال</span> }
            <div class="acts">
                <a class="a-btn sm" href="@Url.Action("Edit", "AdminBanners", new { id = b.Id })">ویرایش</a>
                @using (Html.BeginForm("Delete", "AdminBanners", new { id = b.Id }, FormMethod.Post, new { data_confirm = "این بنر حذف شود؟" }))
                {
                    @Html.AntiForgeryToken()
                    <button class="a-btn sm danger" type="submit">حذف</button>
                }
            </div>
        </div>
    </div>
}
@if (Model.Count == 0) { <p class="muted">بنری ثبت نشده؛ صفحهٔ اصلی بدون بنر نمایش داده می‌شود.</p> }
<a class="a-fab" href="@Url.Action("Create", "AdminBanners")" aria-label="بنر جدید">＋</a>
