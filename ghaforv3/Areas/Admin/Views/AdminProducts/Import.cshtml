@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewBag.Title = "ورود محصولات از اکسل"; }

<div class="a-card">
    <h2 class="a-h">چطور کار می‌کند؟</h2>
    <ol class="a-steps">
        <li>قالب خالی را دانلود کن (یا «خروجی اکسل» بگیر تا همهٔ محصولات فعلی را با همین ستون‌ها داشته باشی).</li>
        <li>اسم کالا، قیمت و بقیهٔ ستون‌ها را پر کن؛ فایل را با فرمت <b>.xlsx</b> (یا CSV) ذخیره کن.</li>
        <li>فایل را اینجا بارگذاری کن. قبل از ثبت، پیش‌نمایش و خطاها را می‌بینی.</li>
    </ol>
    <div class="a-toolbar">
        <a class="a-btn sm" href="@Url.Action("Template", "AdminProducts")">⬇ دریافت قالب خالی</a>
        <a class="a-btn sm ghost" href="@Url.Action("ExportXlsx", "AdminProducts")">📤 خروجی اکسل از محصولات فعلی</a>
    </div>
</div>

@using (Html.BeginForm("ImportUpload", "AdminProducts", FormMethod.Post, new { @class = "a-form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="f">
        <label>فایل اکسل (xlsx) یا CSV — حداکثر ۴ مگابایت و ۲۰۰۰ ردیف</label>
        <input type="file" name="file" accept=".xlsx,.csv" required />
    </div>
    <button class="a-btn" type="submit">بارگذاری و پیش‌نمایش</button>
    <a class="a-btn ghost" href="@Url.Action("Index", "AdminProducts")">بازگشت</a>
}

<div class="a-card">
    <h2 class="a-h">ستون‌ها</h2>
    <p class="muted">ترتیب ستون‌ها مهم نیست؛ فقط عنوان ستون باید همین‌ها (یا معادل انگلیسی) باشد. «نام کالا» و «قیمت» الزامی‌اند.</p>
    <div class="a-scroll">
        <table class="a-table">
            <thead><tr><th>ستون</th><th>الزامی؟</th><th>توضیح</th></tr></thead>
            <tbody>
                <tr><td>نام کالا</td><td>بله</td><td>کالایی که همین نام را دارد به‌روزرسانی می‌شود، وگرنه کالای جدید ساخته می‌شود</td></tr>
                <tr><td>قیمت (تومان)</td><td>بله*</td><td>عدد؛ جداکننده و ارقام فارسی مشکلی ندارد (*برای کالای جدید الزامی است)</td></tr>
                <tr><td>قیمت قبل از تخفیف</td><td>خیر</td><td>باید بیشتر از قیمت فروش باشد تا تخفیف نمایش داده شود</td></tr>
                <tr><td>موجودی</td><td>خیر</td><td>عدد صحیح؛ پیش‌فرض کالای جدید ۰</td></tr>
                <tr><td>دسته‌بندی</td><td>برای کالای جدید</td><td>اگر دسته وجود نداشته باشد خودکار ساخته می‌شود</td></tr>
                <tr><td>برند</td><td>خیر</td><td>اگر وجود نداشته باشد خودکار ساخته می‌شود</td></tr>
                <tr><td>واحد</td><td>خیر</td><td>مثل عدد، حلقه، متر (پیش‌فرض «عدد»)</td></tr>
                <tr><td>فعال</td><td>خیر</td><td>بله / خیر (پیش‌فرض بله)</td></tr>
                <tr><td>کد (Slug)</td><td>خیر</td><td>آدرس لاتین کالا؛ اگر خالی باشد خودکار ساخته می‌شود. برای به‌روزرسانی دقیق، همین کد را نگه دار</td></tr>
                <tr><td>توضیحات</td><td>خیر</td><td>متن توضیح محصول</td></tr>
                <tr><td>کد محصول</td><td>خیر</td><td>کد داخلی/انبار؛ برای به‌روزرسانی هم می‌توان از آن استفاده کرد (یکتا)</td></tr>
                <tr><td>تعداد در کارتن</td><td>خیر</td><td>عدد صحیح</td></tr>
                <tr><td>گارانتی</td><td>خیر</td><td>توضیحات گارانتی محصول</td></tr>
                <tr><td>رنگ بدنه</td><td>خیر</td><td>گزینه‌ها با ویرگول جدا شوند؛ مثل «سفید، مشکی، طلایی»</td></tr>
                <tr><td>رنگ نور</td><td>خیر</td><td>مثل «آفتابی (۲۷۰۰K)، مهتابی (۶۵۰۰K)»</td></tr>
            </tbody>
        </table>
    </div>
    <p class="muted">خانهٔ خالی، مقدار فعلی کالا را پاک نمی‌کند. عکس کالاها را بعداً از «ویرایش محصول» اضافه کن.</p>
</div>
