@model Ghaforv3.Models.ProductFormVm
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewBag.Title = Model.Id == 0 ? "محصول جدید" : "ویرایش محصول"; }

@using (Html.BeginForm("Save", "AdminProducts", FormMethod.Post, new { @class = "a-form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.ImageUrl)
    @Html.ValidationSummary(true, "", new { @class = "a-err" })

    <div class="f">@Html.LabelFor(m => m.Title)@Html.TextBoxFor(m => m.Title)@Html.ValidationMessageFor(m => m.Title, "", new { @class = "a-err" })</div>
    <div class="f">@Html.LabelFor(m => m.Slug)@Html.TextBoxFor(m => m.Slug, new { dir = "ltr", placeholder = "led-10w-e27" })@Html.ValidationMessageFor(m => m.Slug, "", new { @class = "a-err" })</div>
    <div class="f">@Html.LabelFor(m => m.CategoryId)@Html.DropDownListFor(m => m.CategoryId, Model.Categories, "انتخاب کن...")@Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "a-err" })</div>
    <div class="f">@Html.LabelFor(m => m.BrandId)@Html.DropDownListFor(m => m.BrandId, Model.Brands, "بدون برند")</div>
    <div class="two">
        <div class="f">@Html.LabelFor(m => m.Price)@Html.TextBoxFor(m => m.Price, new { type = "number", inputmode = "numeric" })@Html.ValidationMessageFor(m => m.Price, "", new { @class = "a-err" })</div>
        <div class="f">@Html.LabelFor(m => m.OldPrice)@Html.TextBoxFor(m => m.OldPrice, new { type = "number", inputmode = "numeric" })@Html.ValidationMessageFor(m => m.OldPrice, "", new { @class = "a-err" })</div>
    </div>
    <div class="two">
        <div class="f">@Html.LabelFor(m => m.Unit)@Html.TextBoxFor(m => m.Unit)</div>
        <div class="f">@Html.LabelFor(m => m.Stock)@Html.TextBoxFor(m => m.Stock, new { type = "number", inputmode = "numeric" })@Html.ValidationMessageFor(m => m.Stock, "", new { @class = "a-err" })</div>
    </div>
    <div class="f">@Html.LabelFor(m => m.Description)@Html.TextAreaFor(m => m.Description, 5, 30, null)</div>

    <h2 class="a-h">مشخصات و گزینه‌های خرید</h2>
    <div class="two">
        <div class="f">@Html.LabelFor(m => m.Code)@Html.TextBoxFor(m => m.Code, new { dir = "ltr", placeholder = "GH-001" })@Html.ValidationMessageFor(m => m.Code, "", new { @class = "a-err" })</div>
        <div class="f">@Html.LabelFor(m => m.CartonQty)@Html.TextBoxFor(m => m.CartonQty, new { type = "number", inputmode = "numeric" })@Html.ValidationMessageFor(m => m.CartonQty, "", new { @class = "a-err" })</div>
    </div>
    <div class="f">@Html.LabelFor(m => m.BodyColors)@Html.TextBoxFor(m => m.BodyColors, new { placeholder = "سفید، مشکی، طلایی" })@Html.ValidationMessageFor(m => m.BodyColors, "", new { @class = "a-err" })
        <small class="muted">اگر خالی باشد، مشتری رنگ بدنه انتخاب نمی‌کند. حداکثر ۱۲ گزینه.</small></div>
    <div class="f">@Html.LabelFor(m => m.LightColors)@Html.TextBoxFor(m => m.LightColors, new { placeholder = "آفتابی (۲۷۰۰K)، طبیعی (۴۰۰۰K)، مهتابی (۶۵۰۰K)" })@Html.ValidationMessageFor(m => m.LightColors, "", new { @class = "a-err" })
        <small class="muted">برای چراغ‌ها و لامپ‌ها؛ می‌توانی دمای رنگ (کلوین) را داخل پرانتز بنویسی.</small></div>
    <div class="f">@Html.LabelFor(m => m.Warranty)@Html.TextAreaFor(m => m.Warranty, 3, 30, null)@Html.ValidationMessageFor(m => m.Warranty, "", new { @class = "a-err" })</div>

    <div class="f">
        <label>عکس محصول</label>
        @if (!string.IsNullOrEmpty(Model.ImageUrl)) { <img class="prev" src="@Url.Content(Model.ImageUrl)" alt="" /> }
        <input type="file" name="image" accept="image/jpeg,image/png,image/webp" />
        <small class="muted">jpg / png / webp، حداکثر ۲ مگابایت. پیشنهاد: ۶۰۰×۶۰۰</small>
    </div>

    <label class="chk">@Html.CheckBoxFor(m => m.IsActive) @Html.DisplayNameFor(m => m.IsActive)</label>
    <label class="chk">@Html.CheckBoxFor(m => m.IsFlashSale) @Html.DisplayNameFor(m => m.IsFlashSale)</label>
    <label class="chk">@Html.CheckBoxFor(m => m.IsDailyOffer) @Html.DisplayNameFor(m => m.IsDailyOffer)</label>
    <div class="f">@Html.LabelFor(m => m.OfferEndsAt)@Html.TextBoxFor(m => m.OfferEndsAt, "{0:yyyy-MM-ddTHH:mm}", new { type = "datetime-local" })</div>

    <button class="a-btn" type="submit">ذخیره</button>
    <a class="a-btn ghost" href="@Url.Action("Index", "AdminProducts")">انصراف</a>
}
