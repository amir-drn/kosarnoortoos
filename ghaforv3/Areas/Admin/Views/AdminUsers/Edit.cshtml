@model Ghaforv3.Models.UserFormVm
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewBag.Title = Model.Id == 0 ? "کاربر جدید" : "ویرایش کاربر"; }

@using (Html.BeginForm("Save", "AdminUsers", FormMethod.Post, new { @class = "a-form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.ValidationSummary(true, "", new { @class = "a-err" })

    <div class="f">@Html.LabelFor(m => m.FullName)@Html.TextBoxFor(m => m.FullName)@Html.ValidationMessageFor(m => m.FullName, "", new { @class = "a-err" })</div>
    <div class="f">@Html.LabelFor(m => m.Mobile)@Html.TextBoxFor(m => m.Mobile, new { type = "tel", inputmode = "numeric" })@Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "a-err" })</div>
    <div class="f">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { type = "email", dir = "ltr" })@Html.ValidationMessageFor(m => m.Email, "", new { @class = "a-err" })</div>
    <div class="f">@Html.LabelFor(m => m.Role)@Html.DropDownListFor(m => m.Role, Model.Roles)@Html.ValidationMessageFor(m => m.Role, "", new { @class = "a-err" })</div>
    <div class="f">@Html.LabelFor(m => m.Password)@Html.PasswordFor(m => m.Password, new { autocomplete = "new-password" })@Html.ValidationMessageFor(m => m.Password, "", new { @class = "a-err" })</div>
    <label class="chk">@Html.CheckBoxFor(m => m.IsActive) @Html.DisplayNameFor(m => m.IsActive)</label>

    <button class="a-btn" type="submit">ذخیره</button>
    <a class="a-btn ghost" href="@Url.Action("Index", "AdminUsers")">انصراف</a>
    if (Model.Id != 0)
    {
        <button class="a-btn danger" type="submit" formaction="@Url.Action("Delete", "AdminUsers")" formnovalidate data-confirm="این کاربر برای همیشه حذف شود؟">🗑 حذف کاربر</button>
    }
}
