@model System.Collections.Generic.List<Ghaforv3.Models.Order>
@{ ViewBag.Title = "سفارش‌های من"; ViewBag.NoIndex = true; }
<div class="page-head"><h1>سفارش‌های من</h1></div>
@if (TempData["ok"] != null) { <div class="flash ok">@TempData["ok"]</div> }
@if (TempData["err"] != null) { <div class="flash err">@TempData["err"]</div> }
@if (Model.Count == 0)
{
    <div class="empty"><div style="font-size:3rem">🧾</div><p class="muted">هنوز سفارشی ثبت نکرده‌ای.</p><a class="btn" href="@Url.Action("Index","Products")">رفتن به فروشگاه</a></div>
}
else
{
    <div class="clist ord-list">
        @foreach (var o in Model)
        {
            <a class="citem ord" href="@Url.Action("Details","Orders",new{id=o.Id})">
                <div class="cinfo">
                    <b>سفارش #@Fa.Num(o.Id)</b>
                    <small class="muted">@Fa.Stamp(o.CreatedAt) · @Fa.Num(o.OrderItems.Sum(i => i.Quantity)) کالا</small>
                    <div class="crow"><span class="st st@(o.Status)">@Ghaforv3.Models.AdminLabels.Order(o.Status)</span><b>@Fa.Money(o.TotalAmount) تومان</b></div>
                </div>
            </a>
        }
    </div>
}
