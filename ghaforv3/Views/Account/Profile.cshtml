@model Ghaforv3.Models.ProfileVm
@{ ViewBag.Title = "ویرایش پروفایل"; ViewBag.NoIndex = true; }
<div class="auth">
    <h1>ویرایش پروفایل</h1>
    @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "err-note" })
        <div class="f"><label>شمارهٔ موبایل</label><input type="text" value="@Fa.Digits(Model.Mobile)" disabled dir="ltr" /></div>
        <div class="f">@Html.LabelFor(m => m.FullName)@Html.TextBoxFor(m => m.FullName)@Html.ValidationMessageFor(m => m.FullName, "", new { @class = "err-note" })</div>
        <div class="f">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { dir = "ltr", type = "email" })@Html.ValidationMessageFor(m => m.Email, "", new { @class = "err-note" })</div>
        <button class="add-btn" type="submit">ذخیره</button>
    }
</div>
