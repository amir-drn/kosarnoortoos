@model Ghaforv3.Models.PasswordVm
@{ ViewBag.Title = "تغییر رمز عبور"; ViewBag.NoIndex = true; }
<div class="auth">
    <h1>تغییر رمز عبور</h1>
    @using (Html.BeginForm("Password", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "err-note" })
        <div class="f">@Html.LabelFor(m => m.Current)@Html.PasswordFor(m => m.Current, new { autocomplete = "current-password" })@Html.ValidationMessageFor(m => m.Current, "", new { @class = "err-note" })</div>
        <div class="f">@Html.LabelFor(m => m.New)@Html.PasswordFor(m => m.New, new { autocomplete = "new-password" })@Html.ValidationMessageFor(m => m.New, "", new { @class = "err-note" })</div>
        <div class="f">@Html.LabelFor(m => m.Confirm)@Html.PasswordFor(m => m.Confirm, new { autocomplete = "new-password" })@Html.ValidationMessageFor(m => m.Confirm, "", new { @class = "err-note" })</div>
        <button class="add-btn" type="submit">تغییر رمز</button>
    }
</div>
