@model Ghaforv3.Models.LoginVm
@{ ViewBag.Title = "ورود"; }
<div class="auth">
    <h1>ورود به حساب</h1>
    @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "auth-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "auth-err" })
        <div class="f">@Html.LabelFor(m => m.Mobile)@Html.TextBoxFor(m => m.Mobile, new { type = "tel", inputmode = "numeric", autocomplete = "username" })@Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "auth-err" })</div>
        <div class="f">@Html.LabelFor(m => m.Password)@Html.PasswordFor(m => m.Password, new { autocomplete = "current-password" })@Html.ValidationMessageFor(m => m.Password, "", new { @class = "auth-err" })</div>
        <label class="chk">@Html.CheckBoxFor(m => m.Remember) @Html.DisplayNameFor(m => m.Remember)</label>
        <button class="add-btn" type="submit">ورود</button>
    }
    <p class="alt">حساب نداری؟ <a href="@Url.Action("Register", "Account", new { returnUrl = ViewBag.ReturnUrl })">ثبت‌نام</a></p>
</div>
