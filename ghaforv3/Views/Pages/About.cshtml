@{ ViewBag.Title = "دربارهٔ غفوریان"; ViewBag.Description = "فروشگاه اینترنتی غفوریان؛ عرضهٔ لوازم برقی و روشنایی داخلی و فضای باز با ارسال به سراسر ایران."; }
<article class="doc">
    <h1>دربارهٔ غفوریان</h1>
    <p>غفوریان یک فروشگاه تخصصی لوازم برقی و روشنایی است؛ از لامپ و چراغ‌های داخلی و محوطه تا کلید و پریز، سیم و کابل و تابلو برق.</p>
    <h2>چه چیزی ما را متفاوت می‌کند؟</h2>
    <ul>
        <li><b>اصالت کالا:</b> همهٔ محصولات با گارانتی معتبر عرضه می‌شوند.</li>
        <li><b>ارسال سریع:</b> ارسال به سراسر ایران؛ در تهران همان روز.</li>
        <li><b>پرداخت امن:</b> پرداخت آنلاین از طریق درگاه بانکی معتبر.</li>
        <li><b>پشتیبانی:</b> @Ghaforv3.Helpers.Site.Hours</li>
    </ul>
    <p><a class="btn" href="@Url.Action("Index","Products")">مشاهدهٔ محصولات</a> <a class="btn light" href="@Url.Action("Contact","Pages")">تماس با ما</a></p>
</article>
